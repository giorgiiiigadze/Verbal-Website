# The site's public origin. Feeds canonical URLs, Open Graph tags, sitemap.xml
# and robots.txt. No trailing slash.
#
# This file is documentation — Next never loads it. Unset, everything falls back
# to the literal in content/site.ts, which is this same domain. Set it in
# Vercel's project settings so preview deployments describe themselves.
NEXT_PUBLIC_SITE_URL=https://theverbal.app
